---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import About from "../components/About.astro";
import LashClub from "../components/LashClub.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: site.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const servicios = (await getCollection("servicios")).map((entry) => {
  const images: string[] = [];
  for (const style of entry.data.styles) {
    if (style.image) images.push(style.image);
    if (style.gallery) images.push(...style.gallery);
  }
  if (entry.data.gallery) images.push(...entry.data.gallery);
  if (!images.includes(entry.data.image)) images.unshift(entry.data.image);

  return {
    name: entry.data.name,
    image: entry.data.image,
    alt: entry.data.alt,
    text: entry.data.intro,
    price: entry.data.price,
    note: entry.data.note,
    rating: entry.data.rating,
    reviews: entry.data.reviews,
    badge: entry.data.badge,
    href: `/servicios/${entry.id}/`,
    images: [...new Set(images)],
  };
});

const productos = (await getCollection("productos")).map((entry) => ({
  name: entry.data.name,
  image: entry.data.image,
  alt: entry.data.alt,
  text: entry.data.intro,
  price: entry.data.price,
  note: entry.data.note,
  rating: entry.data.rating,
  reviews: entry.data.reviews,
  badge: entry.data.badge,
  href: `/productos/${entry.id}/`,
}));

const cursos = (await getCollection("cursos")).map((entry) => {
  const images = [entry.data.image, ...(entry.data.gallery ?? [])];

  return {
    name: entry.data.name,
    image: entry.data.image,
    alt: entry.data.alt,
    text: entry.data.text,
    price: entry.data.price,
    note: entry.data.note,
    cta: entry.data.cta,
    images,
  };
});
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <h1 class="sr-only">
    Hi Kelly Beauty Estudio — extensiones de pestañas a mano, productos de
    cuidado y cursos para lashistas en Santiago
  </h1>
  <Hero />
  <Showcase
    id="servicios"
    kicker="Servicios"
    title="Servicios para tu"
    accent="estilo"
    description="Extensiones de pestañas, cejas tatuadas y uñas. Cada servicio se diseña contigo y se agenda por WhatsApp."
    items={servicios}
    tone="soft"
    columns={4}
  />
  <Showcase
    id="productos"
    kicker="Productos"
    title="Productos para"
    accent="cuidarla"
    description="Kits, limpieza y cuidado para mantener tu set en casa. Despacho a todo Chile en dos días hábiles."
    items={productos}
    tone="plain"
  />
  <Showcase
    id="cursos"
    kicker="Cursos"
    title="Cursos para"
    accent="lashistas"
    description="Formaciones teórico-prácticas con kit, práctica en modelos y certificación. Cupos limitados por generación."
    items={cursos}
    tone="soft"
  />
  <About />
  <LashClub />
  <Faq />
  <FinalCta />
</Layout>

<script>
  import "../scripts/motion";
</script>
