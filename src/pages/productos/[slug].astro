---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { site, waLink } from "../../data/site";

type Product = CollectionEntry<"productos">["data"];

export async function getStaticPaths() {
  const products = await getCollection("productos");
  return products.map((entry) => ({
    params: { slug: entry.id },
    props: { product: entry.data },
  }));
}

const { product } = Astro.props as { product: Product };

const parsePrice = (value: string): number | undefined => {
  const match = value.replace(/\./g, "").match(/(\d+)/);
  return match ? parseInt(match[1], 10) : undefined;
};

const productPrice = parsePrice(product.price);
const productUrl = `${site.domain}${Astro.url.pathname}`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.intro,
  image: `${site.domain}${product.image}`,
  brand: { "@type": "Brand", name: site.brand },
  ...(productPrice != null && {
    offers: {
      "@type": "Offer",
      priceCurrency: "CLP",
      price: productPrice,
      availability: "https://schema.org/InStock",
      url: productUrl,
    },
  }),
  ...(product.rating != null && {
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: product.rating,
      reviewCount: product.reviews ?? 0,
    },
  }),
};
---

<Layout title={`${product.name} | ${site.brand}`} description={product.intro}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <div class="pt-28 md:pt-36">
    <section class="shell pb-24 md:pb-32">
      <a
        href="/#productos"
        class="reveal inline-flex items-center gap-2 text-sm text-ink-soft transition-colors duration-700 ease-fluid hover:text-ink"
      >
        <span aria-hidden="true">←</span>
        Volver a productos
      </a>

      <div class="reveal mt-8 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div class="relative aspect-square overflow-hidden rounded-[1.5rem] bg-white p-8 shadow-[inset_0_0_0_1px_var(--color-line)] md:p-12">
          <img
            src={product.image}
            alt={product.alt}
            class="size-full object-contain"
            loading="eager"
            decoding="async"
          />
        </div>

        <div>
          <div class="mb-4 flex items-center gap-3">
            <span class="hairline w-10 bg-accent"></span>
            <span class="kicker mb-0">{product.kicker}</span>
          </div>
          <h1 class="font-display text-4xl leading-[1.03] tracking-[-0.02em] md:text-[3.5rem]">
            {product.name}
          </h1>
          <p class="mt-5 max-w-[38rem] text-base leading-relaxed text-ink-soft md:text-lg">
            {product.intro}
          </p>
          <p class="tnum mt-6 text-2xl font-semibold text-ink">
            {product.price}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={waLink(`Hola, quiero tener más información sobre ${product.name}`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Pedir por WhatsApp
            </a>
          </div>
        </div>
      </div>

      <div class="reveal mt-16 md:mt-20">
        <div class="mb-4 flex items-center gap-3">
          <span class="hairline w-10 bg-accent"></span>
          <span class="kicker mb-0">Presentaciones</span>
        </div>
        <h2 class="font-display text-3xl tracking-[-0.02em] md:text-4xl">
          Elige la que va <span class="display-italic">contigo</span>
        </h2>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          product.variants.map((variant, index) => (
            <article
              class="reveal flex flex-col rounded-[1.25rem] bg-white p-6 shadow-[inset_0_0_0_1px_var(--color-line)]"
              style={`transition-delay: ${index * 60}ms`}
            >
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-display text-xl leading-tight text-ink">
                  {variant.name}
                </h3>
                <span class="tnum text-sm font-semibold text-accent">
                  {variant.price}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                {variant.description}
              </p>
              <a
                href={waLink(`Hola, quiero pedir ${product.name} (${variant.name})`)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary mt-5 w-full"
              >
                Pedir
              </a>
            </article>
          ))
        }
      </div>

      <p class="reveal mt-10 text-center text-xs text-ink-dim">
        Precios referenciales. Despacho a todo Chile en dos días hábiles.
      </p>
    </section>
  </div>
</Layout>

<script>
  import "../../scripts/motion";
</script>
