---
import { site } from "../data/site";
---

<section id="sobre" class="shell scroll-mt-24 py-24 md:py-32" aria-labelledby="sobre-titulo">
  <div class="reveal mx-auto max-w-[42rem] text-center">
    <span
      class="inline-flex items-center rounded-full bg-bg-soft px-4 py-1.5 text-[0.65rem] font-semibold tracking-[0.24em] text-accent uppercase shadow-[inset_0_0_0_1px_var(--color-line)]"
    >
      Sobre Hi Kelly
    </span>
    <h2
      id="sobre-titulo"
      class="mt-5 font-display text-4xl leading-[1.03] tracking-[-0.02em] md:text-[3.5rem]"
    >
      La mirada que <span class="display-italic">te define</span>
    </h2>
    <p class="mx-auto mt-4 max-w-[36rem] text-sm leading-relaxed text-ink-soft">
      Medimos, dibujamos y aplicamos cada pestaña a mano. Trabajamos con
      materiales cruelty-free y una asesoría 1:1 que te acompaña antes y
      después de tu set.
    </p>
  </div>

  <div id="estudio" class="mt-12 grid scroll-mt-28 items-center gap-8 rounded-[2rem] bg-bg-soft p-6 sm:p-10 md:grid-cols-[1fr_0.75fr]" aria-labelledby="estudio-titulo">
    <div>
      <p class="kicker">Conoce el estudio</p>
      <h3 id="estudio-titulo" class="mt-3 text-3xl text-ink md:text-5xl">
        Así es Hi Kelly <span class="display-italic">por dentro</span>
      </h3>
      <p class="mt-4 max-w-[34rem] text-lg leading-relaxed text-ink-soft">
        Un espacio cálido y pensado para ti: llega, relájate y sal con esa
        mirada que llevas dentro.
      </p>
      <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-ink-soft">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 text-accent" aria-hidden="true">✦</span>
          Atención 1:1 y diseño a tu medida
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 text-accent" aria-hidden="true">✦</span>
          Materiales cruelty-free certificados
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 text-accent" aria-hidden="true">✦</span>
          Diagnóstico sin costo al agendar
        </li>
      </ul>
      <p class="mt-6 text-xs text-ink-dim">{site.contact.address}</p>
      <a class="btn btn-primary mt-6" href={site.contact.whatsappUrl} target="_blank" rel="noopener noreferrer">Reservar mi hora</a>
    </div>
    <video class="mx-auto aspect-[9/16] w-full max-w-[18rem] rounded-[1.5rem] bg-night object-cover" controls playsinline preload="none" poster="/media/estudio-lash-club.webp" aria-label="Recorrido en video por el estudio Hi Kelly">
      <source src="/media/estudio-recorrido.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="mt-14 grid gap-x-16 gap-y-12 sm:grid-cols-2">
    {
      site.benefits.map((benefit, index) => (
        <article
          class="reveal group border-t border-[var(--color-line)] pt-6 transition-colors duration-700 ease-fluid hover:border-[var(--color-accent)]"
          style={`transition-delay: ${index * 80}ms`}
        >
          <div class="flex items-start justify-between gap-6">
            <h3 class="max-w-[22rem] text-xl text-ink transition-colors duration-700 ease-fluid group-hover:text-accent">
              {benefit.title}
            </h3>
            <span class="font-display text-6xl leading-[0.8] font-bold tnum text-ink transition-transform duration-700 ease-fluid group-hover:-translate-y-1">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
          <p class="mt-5 max-w-[32rem] text-sm leading-relaxed text-ink-soft">
            {benefit.text}
          </p>
        </article>
      ))
    }
  </div>
</section>
