---
import { site } from "../data/site";
---

<section
    id="reserva"
    class="shell py-24 md:py-32"
    aria-labelledby="reserva-titulo"
>
    <div
        class="relative overflow-hidden rounded-[1.75rem] px-8 py-16 md:px-16 md:py-20"
        style="background: linear-gradient(150deg, #fbe9f1 0%, #fbe3ed 55%, #f6dce8 100%); box-shadow: inset 0 0 0 1px var(--color-line)"
    >
        <div
            class="absolute -top-24 right-0 size-[28rem] rounded-full opacity-40 blur-3xl"
            style="background: radial-gradient(closest-side, rgba(176,91,123,0.22) 0%, transparent 70%)"
            aria-hidden="true"
        ></div>

        <div class="relative grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
            <div class="reveal">
                <div class="mb-4 flex items-center gap-3">
                    <span class="hairline w-10 bg-accent"></span>
                    <span class="kicker mb-0">Reserva</span>
                </div>
                <h2
                    id="reserva-titulo"
                    class="font-display text-3xl tracking-[-0.02em] md:text-[3.5rem] md:leading-[1.02]"
                >
                    Agenda tu diagnóstico
                    <span class="display-italic">sin costo</span>
                </h2>
                <p class="mt-5 max-w-[34rem] text-base leading-relaxed text-ink-soft">
                    {site.reservations.note}
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a
                        href={site.contact.whatsappUrl}
                        class="btn btn-primary"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Agendar por WhatsApp
                    </a>
                </div>
            </div>

            <dl class="reveal grid content-start gap-6">
                {site.reservations.methods.map((method) => (
                    <div class="border-t border-[var(--color-line)] pt-5">
                        <dt class="kicker">{method.label}</dt>
                        <dd class="tnum mt-2 text-lg text-ink">
                            <a
                                href={method.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="transition-colors duration-700 ease-fluid hover:text-accent"
                            >
                                {method.value}
                            </a>
                        </dd>
                    </div>
                ))}
                <div class="border-t border-[var(--color-line)] pt-5">
                    <dt class="kicker">Estudio</dt>
                    <dd class="mt-2 text-sm leading-relaxed text-ink-soft">
                        {site.contact.address}
                        <br />
                        {site.contact.hours}
                    </dd>
                </div>
            </dl>
        </div>
    </div>
</section>
