---
import { site } from "../data/site";

const onHome = Astro.url.pathname === "/";
const base = onHome ? "" : "/";

const links = [
  { label: "Estudio", href: `${base}#paseo` },
  { label: "Servicios", href: `${base}#servicios` },
  { label: "Tienda", href: `${base}#productos` },
  { label: "Sobre Hi Kelly", href: `${base}#sobre` },
  { label: "Lash Club", href: "/lash-club/" },
  { label: "Contacto", href: `${base}#reserva` },
];

const ctaHref = site.cta.primary.href;
---

<header class="site-header pointer-events-none fixed inset-x-0 top-0 z-50" data-site-header>
  <div class="header-veil absolute inset-x-0 top-0 h-44" aria-hidden="true"></div>

  <div class="header-shell pt-4 sm:pt-6">
    <div class="nav-shell">
      <span class="nav-bloom" aria-hidden="true"></span>

      <a
        href="/"
        class="brand-lockup"
        aria-label={`${site.brand}, ir al inicio`}
      >
        <img
          src="/logo/logo-horizontal.webp"
          alt="Hi Kelly Beauty Estudio"
          width="480"
          height="387"
          class="brand-logo h-14 w-auto transition-transform duration-700 ease-fluid sm:h-20 lg:h-24"
          decoding="async"
        />
      </a>

      <div class="nav-pill pointer-events-auto" data-header>
        <span class="nav-pill-sheen" aria-hidden="true"></span>

        <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Principal">
          {
            links.map((link) => (
              <a href={link.href} class="nav-link">
                {link.label}
              </a>
            ))
          }
        </nav>

        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-cta hidden lg:inline-flex"
        >
          <span class="nav-spark nav-spark-a" aria-hidden="true"></span>
          <span class="nav-spark nav-spark-b" aria-hidden="true"></span>
          {site.cta.primary.label}
        </a>

        <button
          type="button"
          class="menu-toggle ml-1 grid size-10 place-items-center lg:hidden"
          aria-expanded="false"
          aria-controls="menu-movil"
          aria-label="Abrir menú"
          data-menu-toggle
        >
          <span class="toggle-bar" data-bar-top></span>
          <span class="toggle-bar" data-bar-mid></span>
          <span class="toggle-bar" data-bar-bot></span>
        </button>
      </div>
    </div>

    <div
      id="menu-movil"
      class="menu-overlay pointer-events-none fixed inset-0 z-40 hidden items-center justify-center backdrop-blur-3xl"
      data-menu-overlay
    >
      <span class="menu-aura" aria-hidden="true"></span>

      <nav class="relative flex flex-col items-center gap-6" aria-label="Menú móvil">
        {
          links.map((link, index) => (
            <a
              href={link.href}
              class="menu-link translate-y-12 font-display text-3xl text-ink-inverse opacity-0 transition-all duration-700 ease-fluid"
              style={`transition-delay: ${120 + index * 60}ms`}
              data-menu-link
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-cta inline-flex translate-y-12 items-center justify-center opacity-0 transition-all duration-700 ease-fluid"
          style="transition-delay: 420ms"
          data-menu-link
        >
          <span class="nav-spark nav-spark-a" aria-hidden="true"></span>
          <span class="nav-spark nav-spark-b" aria-hidden="true"></span>
          {site.cta.primary.label}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const pill = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const overlay = document.querySelector<HTMLElement>("[data-menu-overlay]");
  const links = Array.from(
    document.querySelectorAll<HTMLElement>("[data-menu-link]"),
  );
  const top = document.querySelector<HTMLElement>("[data-bar-top]");
  const mid = document.querySelector<HTMLElement>("[data-bar-mid]");
  const bot = document.querySelector<HTMLElement>("[data-bar-bot]");

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;
    if (!toggle || !overlay) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");

    if (open) {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      requestAnimationFrame(() => {
        overlay.classList.remove("pointer-events-none");
        overlay.classList.add("pointer-events-auto");
        links.forEach((link) => {
          link.classList.remove("translate-y-12", "opacity-0");
          link.classList.add("translate-y-0", "opacity-100");
        });
      });
    } else {
      overlay.classList.add("pointer-events-none");
      overlay.classList.remove("pointer-events-auto");
      links.forEach((link) => {
        link.classList.add("translate-y-12", "opacity-0");
        link.classList.remove("translate-y-0", "opacity-100");
      });
      window.setTimeout(() => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
      }, 400);
    }

    if (top && mid && bot) {
      top.style.transform = open
        ? "rotate(45deg) translateY(0)"
        : "translateY(-4px)";
      bot.style.transform = open
        ? "rotate(-45deg) translateY(0)"
        : "translateY(4px)";
      mid.style.opacity = open ? "0" : "1";
    }
  };

  toggle?.addEventListener("click", () => setOpen(!open));
  links.forEach((link) =>
    link.addEventListener("click", () => setOpen(false)),
  );

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) setOpen(false);
  });

  if (header) {
    let ticking = false;
    const sync = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };
    sync();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (pill && window.matchMedia("(hover: hover)").matches) {
    let frame = 0;
    let point: { x: number; y: number } | null = null;

    const paint = () => {
      frame = 0;
      if (!point) return;
      const rect = pill.getBoundingClientRect();
      pill.style.setProperty("--mx", `${point.x - rect.left}px`);
      pill.style.setProperty("--my", `${point.y - rect.top}px`);
    };

    pill.addEventListener("pointermove", (event) => {
      point = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(paint);
    });
  }
</script>

<style>
  @property --brand-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  /* ---------- atmósfera del header ---------- */

  .header-veil {
    background:
      radial-gradient(
        38rem 14rem at 12% -3rem,
        rgba(231, 154, 185, 0.22),
        transparent 72%
      ),
      linear-gradient(
        to bottom,
        var(--color-night) 0%,
        rgba(58, 26, 40, 0.6) 46%,
        rgba(58, 26, 40, 0) 100%
      );
  }

  .header-shell {
    width: 100%;
    padding-inline: 1.25rem;
  }

  .nav-shell {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .nav-bloom {
    position: absolute;
    top: 50%;
    left: -1.5rem;
    z-index: 0;
    width: 13rem;
    height: 10rem;
    border-radius: 999px;
    transform: translateY(-50%);
    background:
      radial-gradient(closest-side, rgba(231, 154, 185, 0.5), transparent 68%),
      radial-gradient(closest-side, rgba(255, 214, 168, 0.24), transparent 70%);
    filter: blur(26px);
    opacity: 0.8;
    pointer-events: none;
    animation: bloom-breathe 8s ease-in-out infinite;
    transition: opacity 0.7s var(--ease-fluid);
  }

  /* ---------- la píldora de navegación ---------- */

  .nav-pill {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.35rem 0.45rem 0.35rem 0.4rem;
    border-radius: 999px;
    background-color: rgba(74, 34, 52, 0.76);
    background-image: linear-gradient(
      180deg,
      rgba(255, 241, 246, 0.1),
      rgba(255, 241, 246, 0.015) 42%,
      rgba(255, 241, 246, 0) 100%
    );
    box-shadow:
      inset 0 0 0 1px rgba(231, 154, 185, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 18px 40px -22px rgba(0, 0, 0, 0.9),
      0 0 34px -12px rgba(231, 154, 185, 0.6);
    backdrop-filter: blur(26px) saturate(150%);
    -webkit-backdrop-filter: blur(26px) saturate(150%);
    transition:
      background-color 0.7s var(--ease-fluid),
      box-shadow 0.7s var(--ease-fluid);
  }

  .site-header.is-scrolled .nav-pill {
    background-color: rgba(58, 26, 41, 0.93);
    box-shadow:
      inset 0 0 0 1px rgba(231, 154, 185, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 24px 50px -26px rgba(0, 0, 0, 0.95),
      0 0 42px -12px rgba(231, 154, 185, 0.7);
  }

  .site-header.is-scrolled .nav-bloom {
    opacity: 0.55;
  }

  .nav-pill-sheen {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  /* barrido de luz que cruza la barra */
  .nav-pill-sheen::before {
    content: "";
    position: absolute;
    top: -60%;
    bottom: -60%;
    left: 0;
    width: 34%;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(255, 241, 246, 0.16) 42%,
      rgba(255, 214, 226, 0.38) 50%,
      transparent 62%
    );
    transform: translateX(-180%) skewX(-14deg);
    animation: pill-sheen 13s ease-in-out infinite;
    animation-delay: 2.5s;
  }

  /* brillo que sigue al cursor */
  .nav-pill-sheen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      200px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 214, 226, 0.22),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 0.6s var(--ease-fluid);
  }

  .nav-pill:hover .nav-pill-sheen::after {
    opacity: 1;
  }

  @media (hover: none) {
    .nav-pill-sheen::after {
      display: none;
    }
  }

  /* ---------- lockup de marca ---------- */

  .brand-lockup {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    pointer-events: auto;
    background: rgba(255, 247, 250, 0.85);
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 0 0 1px rgba(255, 241, 246, 0.6),
      0 10px 30px -16px rgba(58, 26, 40, 0.45);
  }

  .brand-lockup:hover .brand-logo {
    transform: scale(1.03);
  }

  .brand-emblem {
    --emblem-radius: 1.05rem;
    --emblem-border: 3px;
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 3.75rem;
    height: 3.75rem;
    padding: var(--emblem-border);
    border-radius: var(--emblem-radius);
    background: conic-gradient(
      from var(--brand-angle, 0deg),
      var(--color-accent) 0deg,
      #ffe0b8 80deg,
      rgba(255, 241, 246, 0.95) 150deg,
      var(--color-accent-strong) 220deg,
      #ffd9a8 290deg,
      var(--color-accent) 360deg
    );
    box-shadow:
      0 0 26px -2px rgba(231, 154, 185, 0.6),
      0 0 60px -10px rgba(231, 154, 185, 0.45);
    isolation: isolate;
    transition:
      transform 0.7s var(--ease-fluid),
      box-shadow 0.7s var(--ease-fluid);
    animation: emblem-hue 10s linear infinite;
  }

  .brand-lockup:hover .brand-emblem {
    transform: scale(1.04) rotate(-1.5deg);
    box-shadow:
      0 0 34px -2px rgba(231, 154, 185, 0.85),
      0 0 80px -8px rgba(231, 154, 185, 0.6);
  }

  .brand-emblem-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.12rem;
    border-radius: calc(var(--emblem-radius) - var(--emblem-border));
    object-fit: contain;
    background: radial-gradient(
      120% 120% at 28% 16%,
      #ffe4ec 0%,
      #f6bed2 46%,
      #e79ab9 100%
    );
    filter: saturate(1.06) contrast(1.03);
  }

  .brand-emblem::after {
    content: "";
    position: absolute;
    inset: var(--emblem-border);
    z-index: 2;
    border-radius: calc(var(--emblem-radius) - var(--emblem-border));
    box-shadow:
      inset 0 0 0 1px rgba(255, 241, 246, 0.42),
      inset 0 -8px 14px rgba(61, 26, 43, 0.28);
    pointer-events: none;
  }

  .brand-emblem-shine {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    border-radius: inherit;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .brand-emblem-shine::before {
    content: "";
    position: absolute;
    top: -60%;
    left: -30%;
    width: 40%;
    height: 220%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.9),
      transparent
    );
    transform: rotate(16deg) translateX(-220%);
    animation: emblem-shine 6.5s ease-in-out infinite;
    animation-delay: 1.2s;
  }

  .spark {
    position: absolute;
    z-index: 4;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      #fff 0%,
      rgba(255, 214, 226, 0.95) 45%,
      transparent 75%
    );
    filter: drop-shadow(0 0 4px rgba(255, 214, 226, 0.95));
    pointer-events: none;
    animation: spark-twinkle 3.8s ease-in-out infinite;
  }

  .spark-a {
    top: -5px;
    right: -3px;
    width: 7px;
    height: 7px;
    border-radius: 0;
    background: #fff4f8;
    clip-path: polygon(
      50% 0%,
      60% 40%,
      100% 50%,
      60% 60%,
      50% 100%,
      40% 60%,
      0% 50%,
      40% 40%
    );
  }

  .spark-b {
    bottom: -2px;
    left: -4px;
    width: 3px;
    height: 3px;
    animation-delay: 1.1s;
  }

  .spark-c {
    top: 52%;
    right: -7px;
    width: 3px;
    height: 3px;
    animation-delay: 2.2s;
  }

  .brand-words {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--color-ink-inverse);
    background: linear-gradient(
      100deg,
      #fff1f6 0%,
      #f3c3d4 30%,
      #ffe4bd 55%,
      #e79ab9 78%,
      #fff1f6 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: brand-shimmer 10s ease-in-out infinite;
    filter: drop-shadow(0 0 12px rgba(231, 154, 185, 0.28));
  }

  .brand-sub {
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(231, 154, 185, 0.8);
    text-shadow: 0 2px 12px rgba(24, 8, 15, 0.55);
  }

  /* ---------- enlaces ---------- */

  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-inverse-soft);
    transition:
      color 0.5s var(--ease-fluid),
      text-shadow 0.5s var(--ease-fluid);
  }

  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      60% 110% at 50% 130%,
      rgba(231, 154, 185, 0.24),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-fluid);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    bottom: 0.28rem;
    left: 0.75rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      #ffd9a8,
      transparent
    );
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.6s var(--ease-fluid);
  }

  .nav-link:hover {
    color: var(--color-ink-inverse);
    text-shadow: 0 0 18px rgba(231, 154, 185, 0.65);
  }

  .nav-link:hover::before {
    opacity: 1;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* ---------- botón principal ---------- */

  .nav-cta {
    position: relative;
    z-index: 1;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.05rem;
    overflow: hidden;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent-ink);
    background: linear-gradient(
      115deg,
      #f3c3d4 0%,
      #e79ab9 34%,
      #c4708f 68%,
      #e9b3a6 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 0 0 1px rgba(255, 241, 246, 0.28),
      0 8px 24px -10px rgba(196, 112, 143, 0.9),
      0 0 22px -6px rgba(231, 154, 185, 0.65);
    transition:
      transform 0.5s var(--ease-fluid),
      box-shadow 0.5s var(--ease-fluid),
      filter 0.5s var(--ease-fluid);
  }

  .nav-cta::after {
    content: "";
    position: absolute;
    top: -60%;
    bottom: -60%;
    left: 0;
    width: 45%;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(255, 255, 255, 0.55),
      transparent
    );
    transform: translateX(-160%) skewX(-18deg);
    transition: transform 0.9s var(--ease-fluid);
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    filter: saturate(1.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 0 0 1px rgba(255, 241, 246, 0.35),
      0 12px 30px -10px rgba(196, 112, 143, 1),
      0 0 34px -4px rgba(231, 154, 185, 0.8);
  }

  .nav-cta:hover::after {
    transform: translateX(320%) skewX(-18deg);
  }

  .nav-spark {
    position: absolute;
    z-index: 2;
    width: 0.42rem;
    height: 0.42rem;
    background: #fff;
    clip-path: polygon(
      50% 0%,
      62% 38%,
      100% 50%,
      62% 62%,
      50% 100%,
      38% 62%,
      0% 50%,
      38% 38%
    );
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.95));
    animation: nav-sparkle 2.6s var(--ease-fluid) infinite;
    pointer-events: none;
  }

  .nav-spark-a {
    top: 0.28rem;
    left: 0.55rem;
  }

  .nav-spark-b {
    right: 0.6rem;
    bottom: 0.3rem;
    width: 0.3rem;
    height: 0.3rem;
    animation-delay: 1.3s;
  }

  @keyframes nav-sparkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.4) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: scale(1.15) rotate(20deg);
    }
  }

  /* ---------- hamburguesa ---------- */

  .menu-toggle {
    position: relative;
    z-index: 1;
    border-radius: 999px;
    transition:
      background-color 0.5s var(--ease-fluid),
      box-shadow 0.5s var(--ease-fluid);
  }

  .menu-toggle:hover {
    background-color: rgba(231, 154, 185, 0.12);
    box-shadow: 0 0 22px -6px rgba(231, 154, 185, 0.7);
  }

  .toggle-bar {
    position: absolute;
    width: 1.25rem;
    height: 1px;
    background: var(--color-ink-inverse);
    transition: all 0.7s var(--ease-fluid);
  }

  [data-bar-top] {
    transform: translateY(-4px);
  }

  [data-bar-bot] {
    transform: translateY(4px);
  }

  /* ---------- menú móvil ---------- */

  .menu-overlay {
    background:
      radial-gradient(
        52rem 34rem at 50% 0%,
        rgba(231, 154, 185, 0.2),
        transparent 65%
      ),
      rgba(52, 23, 37, 0.86);
  }

  .menu-aura {
    position: absolute;
    inset: -10% -20% auto;
    height: 70%;
    background: radial-gradient(
      closest-side,
      rgba(231, 154, 185, 0.26),
      transparent 70%
    );
    filter: blur(44px);
    pointer-events: none;
  }

  .menu-link {
    transition:
      color 0.5s var(--ease-fluid),
      text-shadow 0.5s var(--ease-fluid),
      transform 0.7s var(--ease-fluid),
      opacity 0.7s var(--ease-fluid);
  }

  .menu-link:hover {
    color: var(--color-accent);
    text-shadow: 0 0 28px rgba(231, 154, 185, 0.65);
  }

  /* ---------- breakpoints ---------- */

  @media (min-width: 640px) {
    .header-shell {
      padding-inline: 1.5rem;
    }

    .brand-emblem {
      --emblem-radius: 1.35rem;
      --emblem-border: 3px;
      width: 5rem;
      height: 5rem;
    }

    .brand-lockup {
      gap: 0.9rem;
    }

    .brand-name {
      font-size: 1.15rem;
    }

    .brand-sub {
      font-size: 0.55rem;
      letter-spacing: 0.32em;
    }
  }

  @media (min-width: 1024px) {
    .header-shell {
