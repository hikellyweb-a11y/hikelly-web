---
type Segment = { text: string; em?: boolean };

const { segments } = Astro.props as { segments?: Segment[] };

const base: Segment[] = [
  { text: "Medimos, dibujamos y aplicamos cada pestaña pensando" },
  { text: "cómo miras tú,", em: true },
  { text: "no en cómo se ve un catálogo" },
];

const active = segments ?? base;

const words = active.flatMap((segment) =>
  segment.text
    .split(" ")
    .filter((word) => word.length > 0)
    .map((word) => ({ word, em: Boolean(segment.em) })),
);
---

<section id="promesa" class="shell py-24 md:py-36" aria-label="Nuestra promesa">
  <div class="mb-10 flex items-center justify-center gap-3">
    <span class="hairline w-10 bg-accent"></span>
    <span class="kicker mb-0">Nuestra promesa</span>
    <span class="hairline w-10 bg-accent"></span>
  </div>

  <p
    class="mx-auto max-w-[46rem] text-center font-display text-[2rem] leading-[1.2] tracking-[-0.02em] md:text-[3.75rem]"
    data-tagline
  >
    {
      words.map((item, index) => (
        <>
          <span class="inline-block" data-word>
            {item.em ? <em class="text-accent">{item.word}</em> : item.word}
          </span>
          {index < words.length - 1 ? " " : ""}
        </>
      ))
    }
  </p>
</section>
