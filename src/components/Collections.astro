---
import { site } from "../data/site";
---

<section id="colecciones" class="shell py-24 md:py-32" aria-labelledby="colecciones-titulo">
  <div class="reveal flex flex-wrap items-end justify-between gap-8">
    <div class="max-w-[36rem]">
      <div class="mb-4 flex items-center gap-3">
        <span class="hairline w-10 bg-accent"></span>
        <span class="kicker mb-0">Colecciones</span>
      </div>
      <h2 id="colecciones-titulo" class="font-display text-3xl tracking-[-0.02em] md:text-5xl">
        Elige tu <span class="display-italic">efecto</span>
      </h2>
    </div>
    <p class="max-w-[24rem] text-sm leading-relaxed text-ink-soft">
      Los valores son referenciales y se confirman en el diagnóstico según el
      largo y la densidad que necesite tu pestaña natural.
    </p>
  </div>

  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      site.collections.map((collection, index) => (
        <article
          class="group relative isolate flex aspect-[3/4] flex-col justify-between overflow-hidden rounded-[1.25rem] p-6 transition-all duration-700 ease-fluid hover:-translate-y-2"
          style="background: linear-gradient(155deg, #fbe9f1 0%, #fbe3ed 58%, #f6dce8 100%); box-shadow: inset 0 0 0 1px var(--color-line)"
        >
          <div
            class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-700 ease-fluid group-hover:opacity-100"
            style="background: radial-gradient(120% 70% at 50% 100%, rgba(176,91,123,0.20) 0%, transparent 70%)"
            aria-hidden="true"
          />
          <span
            class="pointer-events-none absolute top-1/2 left-1/2 -z-10 -translate-x-1/2 -translate-y-1/2 font-display text-[13rem] leading-none text-transparent opacity-30 transition-all duration-700 ease-fluid [-webkit-text-stroke:1px_rgba(58,26,40,0.12)] group-hover:scale-105 group-hover:opacity-50"
            aria-hidden="true"
          >
            {collection.name.charAt(0)}
          </span>

          <div class="flex items-start justify-between">
            <span class="kicker mb-0 tnum">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="rounded-full px-2.5 py-1 text-[0.7rem] font-semibold tnum text-accent shadow-[inset_0_0_0_1px_var(--color-line)]">
              {collection.price}
            </span>
          </div>

          <div class="relative">
            <div class="mb-3 h-px w-10 origin-left scale-x-100 bg-accent transition-transform duration-700 ease-fluid group-hover:scale-x-160" />
            <h3 class="font-display text-3xl leading-none text-ink">
              {collection.name}
            </h3>
            <p class="mt-3 max-w-[18rem] text-sm leading-relaxed text-ink-soft">
              {collection.text}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
