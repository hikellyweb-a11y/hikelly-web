---
import { site } from "../data/site";
---

<section id="preguntas" class="bg-bg-soft py-24 md:py-32" aria-labelledby="preguntas-titulo">
  <div class="shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="reveal">
      <div class="mb-4 flex items-center gap-3">
        <span class="hairline w-10 bg-accent"></span>
        <span class="kicker mb-0">Preguntas frecuentes</span>
      </div>
      <h2 id="preguntas-titulo" class="font-display text-3xl tracking-[-0.02em] md:text-5xl">
        Lo que siempre nos <span class="display-italic">preguntan</span>
      </h2>
      <p class="mt-6 max-w-[26rem] text-sm leading-relaxed text-ink-soft">
        Si tu duda no está acá, escríbenos por WhatsApp. Respondemos el mismo
        día hábil.
      </p>
    </div>

    <div class="divide-y divide-[var(--color-line)]">
      {
        site.faq.map((item, index) => (
          <details
            class="reveal group py-5"
            style={`transition-delay: ${index * 40}ms`}
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-base font-medium text-ink transition-colors duration-700 ease-fluid group-open:text-accent md:text-lg">
              {item.q}
              <span
                class="mt-1.5 grid size-5 shrink-0 place-items-center rounded-full text-ink-soft transition-transform duration-700 ease-fluid group-open:rotate-45 group-open:text-accent"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 16 16"
                  class="size-3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M8 2v12M2 8h12" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 max-w-[42rem] text-sm leading-relaxed text-ink-soft">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
