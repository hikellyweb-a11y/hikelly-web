---
import { site } from "../data/site";

interface Props {
  brand?: string;
  tagline?: string;
  instagram?: string;
  tiktok?: string;
}

const {
  brand = site.brand,
  tagline = site.tagline,
  instagram = site.contact.instagram,
  tiktok = site.contact.tiktok,
} = Astro.props;

const year = new Date().getFullYear();
const base = Astro.url.pathname === "/" ? "" : "/";
---

<footer class="border-t border-[var(--color-line)] bg-bg">
  <div class="shell grid gap-12 py-16 md:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <div class="flex flex-col gap-2">
        <span class="text-xs font-semibold tracking-[0.14em] text-ink uppercase sm:text-sm sm:tracking-[0.2em]">
          {brand}
        </span>
        <span class="hairline w-14 bg-accent"></span>
      </div>
      <p class="mt-4 max-w-[26rem] text-sm leading-relaxed text-ink-soft">
        {tagline}. Extensiones hechas a mano, kits para hacerlo en casa y
        cuidado de tu pestaña natural.
      </p>
      <div class="mt-6 flex gap-3">
        <a
          href={instagram}
          class="social-breathe inline-flex items-center gap-2 rounded-full px-3 py-2 text-sm text-ink-soft shadow-[inset_0_0_0_1px_var(--color-line)] transition-all duration-700 ease-fluid hover:text-ink"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="3.75" />
            <circle cx="17.25" cy="6.75" r="1" fill="currentColor" stroke="none" />
          </svg>
          Instagram
        </a>
        {tiktok && (
          <a
            href={tiktok}
            class="social-breathe inline-flex items-center gap-2 rounded-full px-3 py-2 text-sm text-ink-soft shadow-[inset_0_0_0_1px_var(--color-line)] transition-all duration-700 ease-fluid hover:text-ink"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
            TikTok
          </a>
        )}
      </div>
    </div>

    <nav aria-label="Enlaces del sitio">
      <p class="kicker mb-5">Navegación</p>
      <ul class="grid gap-3 text-sm text-ink-soft">
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href={`${base}#estudio`}>Estudio</a></li>
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href={`${base}#servicios`}>Servicios</a></li>
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href={`${base}#productos`}>Tienda</a></li>
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href={`${base}#cursos`}>Cursos</a></li>
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href={`${base}#sobre`}>Sobre Hi Kelly</a></li>
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href="/lash-club/">Lash Club</a></li>
        <li><a class="transition-colors duration-700 ease-fluid hover:text-ink" href={`${base}#reserva`}>Contacto</a></li>
      </ul>
    </nav>

    <div>
      <p class="kicker mb-5">Políticas</p>
      <ul class="grid gap-3 text-sm text-ink-soft">
        {
          site.footer.legal.map((link) => (
            <li>
              <a
                class="transition-colors duration-700 ease-fluid hover:text-ink"
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="shell flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-line)] py-6 text-xs text-ink-dim">
    <p>© {year} {brand}. Todos los derechos reservados.</p>
    <p>{site.footer.menuHint}</p>
  </div>
</footer>

<style>
  .social-breathe {
    animation: social-breathe 3.6s var(--ease-fluid) infinite;
  }

  @keyframes social-breathe {
    0%,
    100% {
      box-shadow:
        inset 0 0 0 1px var(--color-line),
        0 0 0 0 rgba(231, 154, 185, 0);
      transform: scale(1);
    }
    50% {
      box-shadow:
        inset 0 0 0 1px rgba(176, 91, 123, 0.32),
        0 0 22px -4px rgba(231, 154, 185, 0.65);
      transform: scale(1.045);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-breathe {
      animation: none;
    }
  }
</style>
