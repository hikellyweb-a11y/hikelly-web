---
import { site } from "../data/site";
---

<section id="proceso" class="bg-bg-soft py-24 md:py-32" aria-labelledby="proceso-titulo">
  <div class="shell">
    <div class="reveal max-w-[40rem]">
      <div class="mb-4 flex items-center gap-3">
        <span class="hairline w-10 bg-accent"></span>
        <span class="kicker mb-0">Cómo funciona</span>
      </div>
      <h2 id="proceso-titulo" class="font-display text-3xl tracking-[-0.02em] md:text-5xl">
        Tres pasos, <span class="display-italic">cero sorpresas</span>
      </h2>
    </div>

    <ol class="mt-16 grid gap-y-14 md:grid-cols-3 md:gap-x-12">
      {
        site.steps.map((step, index) => (
          <li
            class="reveal relative border-t border-[var(--color-line)] pt-8 transition-colors duration-700 ease-fluid hover:border-[var(--color-accent)] md:border-t-0 md:border-l md:pt-0 md:pl-8 md:hover:border-[var(--color-accent)]"
            style={`transition-delay: ${index * 90}ms`}
          >
            <span class="ghost-number absolute -top-3 right-0 text-[4.5rem] tnum opacity-60 transition-all duration-700 ease-fluid hover:opacity-100 md:-top-6 md:text-[6.5rem]">
              {index + 1}
            </span>
            <span class="kicker mb-4 block">
              Paso {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="font-display text-2xl text-ink">{step.title}</h3>
            <p class="mt-4 max-w-[24rem] text-sm leading-relaxed text-ink-soft">
              {step.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
