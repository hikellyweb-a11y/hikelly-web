---
import { site } from "../data/site";

const hero = site.stops[0];
---

<section
  id="paseo"
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-night"
  aria-labelledby="hero-titulo"
>
  <img
    src={hero.poster}
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 size-full object-cover"
    style={`object-position: ${hero.focus}`}
  />
  <video
    class="absolute inset-0 size-full object-cover"
    style={`object-position: ${hero.focus}`}
    data-hero-video
    poster={hero.poster}
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline
    preload="auto"
    aria-hidden="true"
  >
    {hero.clip && <source src={hero.clip} type="video/mp4" />}
  </video>

  <button
    type="button"
    class="hero-play"
    data-hero-play
    aria-label="Reproducir video"
    hidden
  >
    <span class="hero-play-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="size-5 translate-x-px" fill="currentColor">
        <path d="M8 5.2 19 12 8 18.8z" />
      </svg>
    </span>
    <span class="hero-play-text">Ver video</span>
  </button>

  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night/90 via-transparent to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-night/55 via-transparent to-night/20"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-night/95 via-night/55 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(90% 70% at 50% 0%, rgba(231,154,185,0.28), transparent 62%), radial-gradient(70% 60% at 85% 80%, rgba(196,112,143,0.20), transparent 60%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[84rem] flex-1 flex-col justify-end px-6 pb-40 md:pb-44">
    <div class="max-w-[42rem]">
      <div class="mb-4 flex items-center gap-3">
        <span class="hairline w-10 bg-ink-inverse/45"></span>
        <span class="kicker mb-0 text-ink-inverse-soft">{hero.kicker}</span>
      </div>
      <h1
        id="hero-titulo"
        class="font-display text-[2.5rem] leading-[1.02] tracking-[-0.02em] text-ink-inverse md:text-[3.75rem]"
      >
        {hero.title}
      </h1>
      <p class="mt-5 max-w-[36rem] text-base leading-relaxed text-ink-inverse-soft md:text-lg">
        {hero.text} · {site.contact.address}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.cta.primary.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {site.cta.primary.label}
        </a>
        <a href={site.cta.secondary.href} class="btn btn-ghost-inverse">
          {site.cta.secondary.label}
        </a>
      </div>
    </div>
  </div>

  <a
    href="#servicios"
    class="hero-cue absolute inset-x-0 bottom-7 z-20 mx-auto flex w-max flex-col items-center gap-3 text-ink-inverse-soft transition-colors duration-700 ease-fluid hover:text-ink-inverse"
    aria-label="Desliza para descubrir nuestros servicios"
  >
    <span class="text-[0.62rem] font-semibold tracking-[0.26em] uppercase">
      Desliza para descubrir nuestros servicios
    </span>
    <span class="hero-cue-track" aria-hidden="true">
      <span class="hero-cue-dot"></span>
    </span>
  </a>
</section>

<style>
  .hero-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    transform: translate(-50%, -50%);
    color: var(--color-ink-inverse);
    cursor: pointer;
  }

  .hero-play[hidden] {
    display: none;
  }

  .hero-play-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 999px;
    background: rgba(58, 26, 40, 0.42);
    box-shadow:
      inset 0 0 0 1px rgba(255, 241, 246, 0.45),
      0 20px 50px -20px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(14px);
    transition:
      transform 0.5s var(--ease-fluid),
      background 0.5s var(--ease-fluid);
  }

  .hero-play-icon::after {
    content: "";
    position: absolute;
    inset: -0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 241, 246, 0.28);
    animation: hero-play-pulse 2.6s var(--ease-fluid) infinite;
  }

  .hero-play:hover .hero-play-icon,
  .hero-play:focus-visible .hero-play-icon {
    background: rgba(58, 26, 40, 0.7);
    transform: scale(1.06);
  }

  .hero-play-text {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-ink-inverse-soft);
  }

  @keyframes hero-play-pulse {
    0% {
      opacity: 0.65;
      transform: scale(0.92);
    }
    70% {
      opacity: 0;
      transform: scale(1.16);
    }
    100% {
      opacity: 0;
      transform: scale(1.16);
    }
  }

  .hero-cue-track {
    position: relative;
    display: block;
    width: 1px;
    height: 3rem;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      rgba(255, 241, 246, 0.05),
      rgba(255, 241, 246, 0.32)
    );
  }

  .hero-cue-dot {
    position: absolute;
    top: 0;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 10px rgba(255, 241, 246, 0.6);
    animation: hero-cue-fall 2.4s cubic-bezier(0.32, 0.72, 0, 1) infinite;
  }

  @keyframes hero-cue-fall {
    0% {
      opacity: 0;
      transform: translateY(-8px);
    }
    22% {
      opacity: 1;
    }
    72% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(52px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cue-dot {
      animation: none;
      opacity: 1;
      transform: translateY(22px);
    }

    .hero-play-icon::after {
      animation: none;
      opacity: 0.35;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const playButton =
    document.querySelector<HTMLButtonElement>("[data-hero-play]");

  if (video) {
    video.muted = true;
    video.defaultMuted = true;

    const showPlayButton = () => {
      if (playButton) playButton.hidden = false;
    };
    const hidePlayButton = () => {
      if (playButton) playButton.hidden = true;
    };

    const play = () => {
      const attempt = video.play();
      if (attempt) attempt.catch(showPlayButton);
    };

    video.addEventListener("playing", hidePlayButton);
    video.addEventListener("pause", () => {
      if (!video.ended) showPlayButton();
    });
    video.addEventListener("error", showPlayButton);

    playButton?.addEventListener("click", () => {
      video.muted = true;
      if (video.readyState === 0) video.load();
      play();
    });

    play();
    video.addEventListener("canplay", play, { once: true });

    // iOS en modo de bajo consumo bloquea el autoplay: reintentamos con el
    // primer toque o tecla sin interrumpir la navegación.
    const unlock = () => {
      play();
      window.removeEventListener("pointerdown", unlock);
      window.removeEventListener("touchstart", unlock);
      window.removeEventListener("keydown", unlock);
    };

    window.addEventListener("pointerdown", unlock, {
      once: true,
      passive: true,
    });
    window.addEventListener("touchstart", unlock, {
      once: true,
      passive: true,
    });
    window.addEventListener("keydown", unlock, { once: true });

    window.setTimeout(() => {
      if (video.paused) showPlayButton();
    }, 2000);
  }
</script>
